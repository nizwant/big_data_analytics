# Copy to .env (git-ignored) and set GITHUB_TOKEN: fine-grained PAT, public repositories read-only.
GITHUB_TOKEN=

# Keep outside OneDrive/Dropbox: sync can lock the SQLite file.
DATA_DIR=./data

# Watch-list: build with python -m gh_poller.watchlist (default DATA_DIR/watchlist.csv).
# WATCHLIST_PATH=./watchlist.dev.csv
TIER1_INTERVAL_S=120
# Empty: automatic, tier-2 timelines / TIER2_BUDGET_PER_H in whole hours.
TIER2_INTERVAL_S=
# Cap on paid tier-2 page requests per hour (304s are free).
TIER2_BUDGET_PER_H=3500
WATCHLIST_MAX_PAGES=3
# Organisation timeline only if R repos are at least this share of its public repos (0 = always).
ORG_MIN_R_SHARE=0.5
# CRANTOGIT_URL=https://raw.githubusercontent.com/r-universe-org/cran-to-git/master/crantogit.csv

# Global track: GET /events
GLOBAL_TRACK_ENABLED=true
GLOBAL_MIN_INTERVAL_S=60
GLOBAL_MAX_PAGES=3

USER_AGENT=bda-cran-poller
